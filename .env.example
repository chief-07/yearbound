# ==========================================
# YEARBOUND — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Walrus Memory Mainnet (Required for Track & Walrus Memory Bounty)
# Obtain from Mysten Labs / Walrus developer dashboard
WALRUS_DELEGATE_KEY=your_walrus_delegate_key_hex
WALRUS_ACCOUNT_ID=your_walrus_account_id
WALRUS_RELAYER_URL=https://relayer.walrus.space
WALRUS_NAMESPACE=yearbound-mainnet

# 2. Tatum Infrastructure (Required for Track & Tatum AI Builder Bounty)
# Obtain free from https://dashboard.tatum.io
TATUM_API_KEY=your_tatum_api_key_here
TATUM_SUI_RPC_URL=https://api.tatum.io/v3/blockchain/node/sui-mainnet

# 3. Sui Blockchain & Vault Escrow
# Deployed Sui Move contract addresses (testnet or mainnet)
NEXT_PUBLIC_SUI_NETWORK=mainnet
VAULT_PACKAGE_ID=0x_your_deployed_vault_package_id
VAULT_OBJECT_ID=0x_your_shared_vault_object_id

# Agent Wallet Private Key (for signing x402 automated penalty deposits)
# Format: Bech32 (suiprivkey1...) or hex
SUI_AGENT_PRIVATE_KEY=suiprivkey1_example_agent_key

# 4. AI Engine (Google Gemini via Vercel AI SDK)
# Obtain free from https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# 5. Application URL (used for internal x402 endpoint routing)
NEXT_PUBLIC_APP_URL=http://localhost:3000
