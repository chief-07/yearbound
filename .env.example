# ==========================================
# YEARBOUND — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Walrus Memory (Required for persistent cross-session MemWal storage)
# Falls back to in-memory MemWalMock locally if omitted
WALRUS_DELEGATE_KEY=your_walrus_delegate_key_hex
WALRUS_ACCOUNT_ID=your_walrus_account_id
WALRUS_RELAYER_URL=https://relayer.memory.walrus.xyz
WALRUS_NAMESPACE=yearbound

# 2. Tatum Infrastructure (Sui GraphQL Gateway)
# Obtain from https://dashboard.tatum.io (falls back to public Sui GraphQL on rate-limit)
TATUM_API_KEY=your_tatum_api_key_here
TATUM_SUI_GATEWAY_URL=https://sui-mainnet.gateway.tatum.io/graphql

# 3. Sui Network & Escrow Vault
NEXT_PUBLIC_SUI_NETWORK=mainnet
# Optional custom Mainnet escrow address & deployed Move Vault object identifiers
# YEARBOUND_VAULT_ADDRESS=0x...
# VAULT_PACKAGE_ID=0x...
# VAULT_OBJECT_ID=0x...

# 4. AI Engine (Google Gemini via Vercel AI SDK)
# Obtain from https://aistudio.google.com (falls back to deterministic parsing/auditing if omitted)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# 5. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
